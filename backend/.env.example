# OpenAI API (model used for extraction + conversion)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Firebase Config
FIREBASE_PROJECT_ID=firebase_project_id_here
# Path relative to backend/ (e.g. .secrets/firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT=.secrets/firebase-service-account.json

# CORS (comma-separated origins for the Next.js app)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://mealprepper.production.com,https://mealprepper.staging.com

# Stripe (server-side only for secret keys — copy real values to backend/.env, never commit)
# Docs: https://docs.stripe.com/keys — Dashboard: Developers → API keys; Webhooks → signing secret (whsec_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional until Checkout / Stripe.js on the client
STRIPE_PUBLISHABLE_KEY=
# From Product catalog → Price ID (test vs live per environment)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Stripe redirects (full URLs for local or production frontend)
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/dashboard?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/dashboard?checkout=cancel
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/dashboard