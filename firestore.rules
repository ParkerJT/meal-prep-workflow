rules_version = '2';

// Client SDK rules. Backend uses Admin SDK and bypasses these.

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user saves — owner may read/write their own subcollection.
    match /users/{userId}/saved_recipes/{savedRecipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscription snapshot — owner read only; backend (Admin SDK) writes via webhooks.
    match /users/{userId}/subscription/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Generation preferences — owner may read/write their own subcollection.
    match /users/{userId}/generation_preferences/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Stripe customer id → Firebase uid (backend-only).
    match /stripe_customers/{customerId} {
      allow read, write: if false;
    }
  }
}
